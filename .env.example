# Copy to .env for local dev. Not needed when deployed as a Databricks App
# if its auto-injected credentials work (see backend/main.py's fallback
# path) -- DATABRICKS_HTTP_PATH is still required either way.

# SQL warehouse's "Connection details" tab in the Databricks UI:
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=

# Personal access token -- simplest path for local dev. Leave unset to use
# the Databricks SDK's default credential chain (e.g. a configured CLI
# profile) instead.
DATABRICKS_TOKEN=
